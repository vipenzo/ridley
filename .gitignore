.claude/

# Tauri
desktop/src-tauri/target/
desktop/src-tauri/gen/

# Local scratch imports. Third-party STLs land here while working on the STL
# acquisition tools; import-stl references them BY PATH precisely so a model can
# be shared when the mesh itself may not be redistributed — keep them out of a
# public repo. check.txt predates this rule and stays tracked.
desktop/tmp/
!desktop/tmp/check.txt

# OS
.DS_Store
Thumbs.db
manual-output/

# Local-only announcement / release drafts
announcements/

# Parametric-acquisition photo sessions: the source jpegs are large (~74MB total)
# and NOT needed by the test suite (it is synthetic). They only serve to re-run
# the real-photo gates. Keep the text derivatives (NOTE.md, session.json,
# picks.edn, predictions.json) tracked; keep the images local.
test-assets/param-acq*/*.jpeg

# edit-acquire's per-session state (poses/picks/residuals) — always regenerated
# by the app next to a session's photos, never a source file.
test-assets/param-acq*/acquire-state.json

# Playwright MCP's own scratch (screenshots, page snapshots, console logs).
.playwright-mcp/
