# Local scratch imports. Third-party STLs land here while working on the STL
# acquisition tools; import-stl references them BY PATH precisely so a model can
# be shared when the mesh itself may not be redistributed — keep them out of a
# public repo. check.txt predates this rule and stays tracked.
desktop/tmp/
!desktop/tmp/check.txt

# OS
.DS_Store
Thumbs.db
manual-output/

# Local-only announcement / release drafts
announcements/

# Parametric-acquisition photo sessions: the source jpegs are large (~117MB now,
# with the two plate sessions) and NOT needed by the test suite (it is synthetic;
# the one real-photo test is guarded and skips when they are absent). They only
# serve to re-run the real-photo gates locally. Keep the text derivatives
# (NOTE.md, session.json, picks.edn, predictions.json) tracked; keep the images
# local. Pattern widened from param-acq* to every session dir, so a new one is
# covered by its existence rather than by remembering to add a line.
test-assets/*/*.jpeg
test-assets/*/*.jpg
test-assets/*/*.heic
test-assets/*/*.HEIC

# edit-acquire's per-session state (poses/picks/residuals) — always regenerated
# by the app next to a session's photos, never a source file. Tracking it would
# mean a permanently dirty working tree (the app rewrites it every session), and
# without the photos it cannot be replayed anyway; the real clicks worth keeping
# are lifted into the test files as fixtures (plate_mirror_test, planar_twin_test,
# match_plate_test).
test-assets/*/acquire-state.json

# Playwright MCP's own scratch (screenshots, page snapshots, console logs).
.playwright-mcp/
